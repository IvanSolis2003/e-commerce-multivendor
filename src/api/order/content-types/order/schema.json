{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "orderNumber": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "orderStatus": {
      "type": "enumeration",
      "default": "pending",
      "enum": [
        "pending",
        "processing",
        "shipped",
        "delivered",
        "cancelled"
      ]
    },
    "totalAmount": {
      "type": "decimal",
      "min": 0
    },
    "subtotal": {
      "type": "decimal",
      "min": 0
    },
    "shippingCost": {
      "type": "decimal",
      "default": 0
    },
    "tax": {
      "type": "decimal",
      "default": 0
    },
    "discount": {
      "type": "decimal",
      "default": 0
    },
    "paymentMethod": {
      "type": "enumeration",
      "enum": [
        "credit_card",
        "debit_card",
        "paypal",
        "stripe",
        "cash_on_delivery"
      ]
    },
    "paymentStatus": {
      "type": "enumeration",
      "default": "pending",
      "enum": [
        "pending",
        "paid",
        "failed",
        "refunded"
      ]
    },
    "shippingAddress": {
      "type": "json",
      "required": true
    },
    "customerNotes": {
      "type": "text"
    },
    "trackingNumber": {
      "type": "string"
    },
    "estimatedDelivery": {
      "type": "date"
    }
  }
}
