# Copiar a deploy/.env en la instancia y rellenar. NUNCA versionar el .env real.

# Dominio publico del backend. Debe tener un registro A apuntando a la IP
# elastica de la instancia antes de levantar Caddy.
DOMINIO=api.ecommerce.iasmtech.com
PUBLIC_URL=https://api.ecommerce.iasmtech.com

# Base de datos: Neon, endpoint POOLED (el host con sufijo -pooler).
# El directo se usa solo para dump y restore.
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Secretos de Strapi. Copiar tal cual los que ya existen: si cambian se
# invalidan las sesiones y los datos cifrados que trae el respaldo.
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=
JWT_SECRET=

# Cloudinary: donde viven las imagenes. La tabla files solo guarda las URLs.
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# Origenes permitidos por CORS, separados por coma. Sin barra final.
CORS_ORIGINS=https://ecommerce.iasmtech.com
