# Strapi
HOST=0.0.0.0
PORT=1337
APP_KEYS=generate_your_keys
API_TOKEN_SALT=generate_your_salt
ADMIN_JWT_SECRET=generate_your_secret
TRANSFER_TOKEN_SALT=generate_your_salt
JWT_SECRET=generate_your_secret

# Database (Production - PostgreSQL/Railway)
DATABASE_CLIENT=postgres
DATABASE_URL=postgres://user:password@host:port/database
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Cloudinary (Images Persistence)
CLOUDINARY_NAME=your_name
CLOUDINARY_KEY=your_key
CLOUDINARY_SECRET=your_secret
